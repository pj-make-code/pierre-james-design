// Writes content/projects/index.generated.ts: one import per project folder.
// Runs automatically before `npm run dev` and `npm run build`, so adding a project
// is just: copy a folder in content/projects/, edit its index.mdx.
import { readdirSync, existsSync, writeFileSync } from "node:fs";
import { join } from "node:path";

const root = join(import.meta.dirname, "..", "content", "projects");
const slugs = readdirSync(root, { withFileTypes: true })
  .filter((d) => d.isDirectory() && existsSync(join(root, d.name, "index.mdx")))
  .map((d) => d.name)
  .sort();

const ident = (slug: string) => "p_" + slug.replace(/[^a-z0-9]/g, "_");
const lines = [
  "// AUTO-GENERATED by scripts/generate-content-index.ts — do not edit by hand.",
  "",
  ...slugs.map((s) => `import * as ${ident(s)} from "./${s}/index.mdx";`),
  "",
  "export const projectModules = {",
  ...slugs.map((s) => `  ${JSON.stringify(s)}: ${ident(s)},`),
  "};",
  "",
];
writeFileSync(join(root, "index.generated.ts"), lines.join("\n"));
console.log(`content index: ${slugs.length} projects`);
